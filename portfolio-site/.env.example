# Environment variables for the portfolio site.
#
# NEXT_PUBLIC_* vars are inlined into the browser bundle at `next build` and
# frozen for the life of that deployment. Set them in Vercel BEFORE the build
# runs; changing a value in the dashboard does not update an existing
# deployment, you have to redeploy.
#
# Local setup:
#   vercel link
#   vercel env pull .env.local     # .env.local is gitignored, never commit it
#   npm run dev

# PostHog project key. Public by design (it is a write-only ingest key).
# Scope in Vercel: Production, Preview.
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog ingest host. us cloud or eu cloud.
# Scope in Vercel: Production, Preview.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Localhost override. Analytics are off on `next dev` by default so local work
# doesn't show up in the dashboard. Set to "true" in .env.local only while
# verifying that events fire. Never set this in Vercel.
# NEXT_PUBLIC_POSTHOG_DEBUG=true

# Password for the two private index pages, / and /agency. Server-side only,
# never NEXT_PUBLIC. Any username works at the browser prompt; the password is
# the whole secret. Read by proxy.ts. If this is unset in production those two
# pages return 503 rather than becoming public.
# Scope in Vercel: Production, Preview.
SITE_PASSWORD=
